{
  "schemaVersion": 2,
  "imageName": "nginx:latest",
  "ports": ["80", "443"],
  "env": [
    {
      "key": "APP_ENV",
      "default": "prod"
    },
    {
      "key": "APP_SECRET",
      "default": ""
    },
    {
      "key": "POSTGRES_DB",
      "default": "app"
    },
    {
      "key": "POSTGRES_USER",
      "default": "app"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "default": ""
    },
    {
      "key": "POSTGRES_VERSION",
      "default": "16"
    },
    {
      "key": "TIMEZONE",
      "default": "UTC"
    }
  ]
}
