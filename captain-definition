{
  "schemaVersion": 2,
  "dockerfilePath": "./docker-compose.prod.yaml",
  "displayName": "GopenuxChat Backend",
  "description": "Symfony backend with PHP, Nginx and PostgreSQL",
  "isComposeFile": true,
  "serviceType": "DockerCompose",
  "ports": [
    {
      "containerPort": 80,
      "description": "HTTP"
    },
    {
      "containerPort": 443,
      "description": "HTTPS"
    }
  ],
  "env": [
    {
      "key": "APP_ENV",
      "description": "Symfony environment",
      "default": "prod"
    },
    {
      "key": "APP_SECRET",
      "description": "Symfony secret key - CHANGE THIS!",
      "default": ""
    },
    {
      "key": "POSTGRES_DB",
      "description": "PostgreSQL database name",
      "default": "app"
    },
    {
      "key": "POSTGRES_USER",
      "description": "PostgreSQL user",
      "default": "app"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "description": "PostgreSQL password - CHANGE THIS!",
      "default": ""
    },
    {
      "key": "POSTGRES_VERSION",
      "description": "PostgreSQL version",
      "default": "16"
    },
    {
      "key": "TIMEZONE",
      "description": "Application timezone",
      "default": "UTC"
    }
  ]
}
